# --- Supabase (required) ---
# Supabase Dashboard -> Connect -> Session pooler connection string.
# Keep this URL on the server only; it contains your database password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
# Auto-detected for supabase.co / supabase.com hosts. Set to true for other hosts.
# DATABASE_SSL=false
# DB_POOL_MAX=5

# --- Server ---
PORT=5000
FRONTEND_DIST=../frontend/dist
# Comma-separated origins, or * for any origin.
CORS_ORIGIN=http://localhost:5173
