{
  "name": "crud-test2-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express + Supabase Postgres REST API for products, users and orders",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:setup": "node src/setup-db.js",
    "build:frontend": "npm --prefix ../frontend run build",
    "serve": "npm run build:frontend && node src/server.js",
    "seed": "node src/seed.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^4.21.2",
    "pg": "^8.23.1"
  }
}
